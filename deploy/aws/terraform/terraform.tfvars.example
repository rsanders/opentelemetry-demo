# Copy to terraform.tfvars (gitignored) and fill in your own values.

# Required: restrict SSH (22) and the demo frontend (8080) to your own IP.
# Find yours with: curl -s https://checkip.amazonaws.com
allowed_cidr = "203.0.113.4/32"

# Optional overrides (defaults shown):
# alert_email          = ""   # set to get emailed when the instance or a service is down 15+ min (see README)
# region               = "us-east-1"
# project_name         = "otel-demo"
# instance_type        = "t3.xlarge"
# root_volume_size_gb  = 60
# compose_profile      = "core" # or "full" to add Kafka/accounting/fraud-detection
