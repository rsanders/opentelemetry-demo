# Rendered by Ansible (roles/cloudwatch_agent) and appended on top of
# amazon-cloudwatch-agent.json via `amazon-cloudwatch-agent-ctl -a
# append-config` (the agent is itself built on the OpenTelemetry Collector,
# and accepts a second, OTel-native YAML config layered on its JSON one --
# https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-OTLPCloudWatchAgent.html).
# Every component/pipeline name below carries a /cwagent suffix per that
# doc's own guidance, so it can't collide with pipelines the agent
# auto-generates from amazon-cloudwatch-agent.json.
#
# Just box infra here (cpu/memory/disk/network/load), collected directly by
# this collector, which runs on the host itself (not in Docker, unlike the
# demo's own otel-collector container) so there's no IMDS hop-limit issue.
# Per-service health/restart-count metrics don't go through the CloudWatch
# agent at all -- roles/service_health's check script pushes those straight
# into the demo's own otel-collector container over OTLP instead (see that
# role and terraform/monitoring.tf), so they ride the same
# resourcedetection/export pipeline as every other service's telemetry. The
# agent's own component allowlist has no httpcheck or docker-stats receiver
# anyway, which is why those checks couldn't live here even if it seemed
# convenient to consolidate.
receivers:
  hostmetrics/cwagent:
    collection_interval: 60s
    scrapers:
      cpu: {}
      memory: {}
      disk: {}
      filesystem: {}
      load: {}
      network: {}
      paging: {}

processors:
  batch/cwagent: {}
  resourcedetection/cwagent:
    detectors: [env, system, ec2]

exporters:
  otlphttp/cwagent:
    metrics_endpoint: https://monitoring.{{ aws_region }}.amazonaws.com/v1/metrics
    compression: gzip
    auth:
      authenticator: sigv4auth/cwagent

extensions:
  sigv4auth/cwagent:
    region: {{ aws_region }}
    service: monitoring

service:
  extensions: [sigv4auth/cwagent]
  pipelines:
    metrics/cwagent:
      receivers: [hostmetrics/cwagent]
      processors: [resourcedetection/cwagent, batch/cwagent]
      exporters: [otlphttp/cwagent]
