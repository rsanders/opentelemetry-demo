# Rendered by Ansible (roles/otel_demo) from otelcol-config-extras-aws.yml.j2.
# Overwrites the upstream stub at src/otel-collector/otelcol-config-extras.yml,
# which is the repo's documented seam for adding exporters without touching
# upstream files. This file is always loaded last on top of otelcol-config.yml,
# so it only needs to repeat the *exporters* arrays it wants to keep (map keys
# merge; only conflicting array keys are replaced) -- see the comment in the
# original stub for details.

extensions:
  # Signs requests to the CloudWatch metrics OTLP endpoint. Credentials come
  # from the EC2 instance role through the default AWS SDK chain.
  sigv4auth/metrics:
    service: 'monitoring'
    region: {{ aws_region }}

processors:
  # Sized to stay inside the metrics endpoint's per-request limits of 1000
  # data points and 1 MB uncompressed.
  batch/metrics:
    send_batch_size: 200
    timeout: 10s

exporters:
  awsxray:
    region: {{ aws_region }}
  awscloudwatchlogs:
    region: {{ aws_region }}
    log_group_name: '{{ app_log_group }}'
    log_stream_name: 'otel-collector'
  # CloudWatch's OpenTelemetry metrics endpoint. This is plain OTLP/HTTP with
  # SigV4 signing rather than an AWS-specific exporter, so metrics land in
  # CloudWatch's OTel metric store -- queried with PromQL in Query Studio,
  # not as a classic namespace in the Metrics console.
  otlphttp/metrics:
    metrics_endpoint: https://monitoring.{{ aws_region }}.amazonaws.com/v1/metrics
    compression: gzip
    auth:
      authenticator: sigv4auth/metrics

service:
  extensions: [sigv4auth/metrics]
  pipelines:
    traces:
      exporters: [debug, span_metrics, awsxray]
    metrics:
      processors: [resourcedetection, memory_limiter, batch/metrics]
      exporters: [debug, otlphttp/metrics]
    logs:
      exporters: [debug, awscloudwatchlogs]
