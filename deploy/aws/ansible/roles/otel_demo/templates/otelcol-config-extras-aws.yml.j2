# Rendered by Ansible (roles/otel_demo) from otelcol-config-extras-aws.yml.j2.
# Overwrites the upstream stub at src/otel-collector/otelcol-config-extras.yml,
# which is the repo's documented seam for adding exporters without touching
# upstream files. This file is always loaded last on top of otelcol-config.yml,
# so it only needs to repeat the *exporters* arrays it wants to keep (map keys
# merge; only conflicting array keys are replaced) -- see the comment in the
# original stub for details.

# One CloudWatch log stream per service (below, via the routing connector):
# the OTLP logs endpoint takes its log group/stream as static headers on the
# exporter, not per-record, so getting one stream per service means one
# exporter instance per service, statically listed here. Keep this in sync
# with compose.yaml's OTEL_SERVICE_NAME values by hand -- a service missing
# from this list still gets exported, just bucketed into the shared "other"
# stream rather than its own. Mirror any change here in the sibling
# deploy/aws-ecs/cdk/files/otelcol-config-extras-aws.yml, which has no
# templating and so lists the same services out by hand instead of looping.
{% set log_stream_services = [
  'ad', 'cart', 'checkout', 'currency', 'email', 'frontend', 'frontend-proxy',
  'image-provider', 'load-generator', 'payment', 'product-catalog', 'quote',
  'recommendation', 'shipping', 'flagd', 'flagd-ui', 'telemetry-docs',
] %}

extensions:
  # Signs requests to the CloudWatch metrics OTLP endpoint. Credentials come
  # from the EC2 instance role through the default AWS SDK chain.
  sigv4auth/metrics:
    service: 'monitoring'
    region: {{ aws_region }}
  # Signs requests to the CloudWatch logs OTLP endpoint. Separate authenticator
  # instance because the service name differs ("logs" vs "monitoring") -- each
  # sigv4auth extension signs for exactly one service.
  sigv4auth/logs:
    service: 'logs'
    region: {{ aws_region }}
  # Signs requests to the CloudWatch (X-Ray) traces OTLP endpoint. The SigV4
  # service name is "xray", not "traces" -- it's the same X-Ray ingestion API
  # underneath, just reached via /v1/traces instead of the classic API.
  sigv4auth/traces:
    service: 'xray'
    region: {{ aws_region }}

receivers:
  # flagd v0.16 has OTLP metrics/traces support but no OTLP logs exporter.
  # Docker forwards only flagd's stdout to this host-published receiver; its
  # dedicated pipeline below assigns the missing resource identity before the
  # existing routing connector sends it to CloudWatch over OTLP/HTTP.
  fluent_forward/flagd:
    endpoint: 0.0.0.0:8006

processors:
  # Adds the `ec2` detector on top of the base config's [env, docker, system]
  # so traces/logs/metrics carry cloud.provider, cloud.platform, cloud.region,
  # cloud.availability_zone, cloud.account.id, host.id (instance ID), and
  # host.image.id/host.type -- none of which the other three detectors set --
  # letting the CloudWatch console correlate telemetry back to the EC2
  # instance/AZ/account it came from. Appended last (after `system`) rather
  # than inserted earlier so it doesn't touch the existing host.name value:
  # the resourcedetection processor lets the first detector to set a given
  # key win, and `system` above is deliberately configured (hostname_sources:
  # ["os"]) to be the source of truth for host.name.
  # https://github.com/open-telemetry/opentelemetry-collector-contrib/blob/v0.157.0/processor/resourcedetectionprocessor/internal/aws/ec2/documentation.md
  #
  # Requires http_put_response_hop_limit = 2 on the instance's IMDS metadata
  # options (see ec2.tf) -- the collector calls the EC2 detector from inside
  # its Docker container, which is an extra network hop past the default
  # hop limit of 1, so without it this detector times out.
  # https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/configuring-IMDS-new-instances.html
  resourcedetection:
    detectors: [env, docker, system, ec2]
  # Tells CloudWatch which log group holds a service's logs, so the "Logs"
  # panel on a trace/metric detail page (X-Ray, Application Signals,
  # Transaction Search) knows where to search -- without it, the console has
  # no way to find the correlated logs even though the trace_id/span_id are
  # already present on every log record. Every service here shares one log
  # group (distinguished only by stream -- see the otlphttp/logs/* exporters
  # below), so the same static value is correct for all of them.
  # https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-Application-Signals-Enable-EC2Main.html
  resource/aws_log_correlation:
    attributes:
      - key: aws.log.group.names
        value: '{{ app_log_group }}'
        action: upsert
  # Every app service already sets service.namespace itself, via
  # OTEL_RESOURCE_ATTRIBUTES (.env's OTEL_SERVICE_NAMESPACE) -- but that's a
  # static "opentelemetry-demo" shared across every deployment target
  # (local, EC2, ECS), not this stack's actual identity. Upsert overrides it
  # with project_name, the same value main.tf tags every resource with as
  # awsApplication, so a service.namespace-based query/dashboard matches the
  # same resources Resource Groups/myApplications groups under that tag.
  # Also the only way collector-scraped signals (redis/postgresql/nginx/
  # prometheus/envoy, none of which are OTel SDKs) get a service.namespace
  # at all, since they never had one to begin with.
  resource/aws_application:
    attributes:
      - key: service.namespace
        value: '{{ project_name }}'
        action: upsert
  resource/aws_deployment:
    attributes:
      - key: service.version
        value: '{{ otel_service_version }}'
        action: upsert
  resource/flagd_logs:
    attributes:
      - key: service.name
        value: flagd
        action: upsert
  # The host_metrics process scraper copies full process commands into
  # resource attributes. On this host, process.command_line reaches 5,375
  # characters (the ad service's Java classpath) and process.command reaches
  # 1,151 characters (Chromium), but CloudWatch's OTLP metrics endpoint caps
  # resource string values at 1,024 characters and silently drops every data
  # point carrying a longer value. Remove these high-cardinality command fields
  # before export; executable name/path and process.pid still identify the
  # process without exporting command arguments or environment-derived values.
  resource/sanitize_cloudwatch_metrics:
    attributes:
      - key: process.command
        action: delete
      - key: process.command_line
        action: delete
  # Keep every other resource attribute, but truncate any string that exceeds
  # CloudWatch's 1,024-character limit. The resource processor above handles
  # the known host_metrics offenders; this transform is the safety net for
  # future receivers or SDKs so one oversized value cannot drop its metric
  # data points at the backend. false means nested maps are traversed too.
  transform/sanitize_cloudwatch_metric_resources:
    error_mode: ignore
    metric_statements:
      - context: resource
        statements:
          - truncate_all(resource.attributes, 1024, false)
  # CloudWatch's OTLP metrics endpoint only supports Counter, Gauge, and
  # Histogram (https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/metrics-otel-send.html#metrics-otel-send-types).
  # Anything else -- Summary, ExponentialHistogram, or a typeless metric shell
  # with no data points -- gets rejected per-metric with "Invalid OTel metric
  # type" on an otherwise-successful request. Drop those before they're sent
  # rather than pay for a rejected request every export interval.
  filter/cloudwatch_metrics:
    error_mode: ignore
    metric_conditions:
      - 'metric.type == METRIC_DATA_TYPE_SUMMARY'
      - 'metric.type == METRIC_DATA_TYPE_EXPONENTIAL_HISTOGRAM'
      - 'metric.type == METRIC_DATA_TYPE_NONE'
  # CloudWatch rejects cumulative points with no StartTimeUnixNano, and the
  # prometheus/ad receiver (like prometheus receivers generally) doesn't set
  # one. subtract_initial_point over the true_reset_point default: it never
  # emits a start==end point (some backends reject those), and it's
  # stateless, which matters since the collector is force-recreated on every
  # deploy. Trade-off: each series' first point after a restart is dropped.
  metric_start_time:
    strategy: subtract_initial_point
  # Sized to stay inside the metrics endpoint's per-request limits of 1000
  # data points and 1 MB uncompressed. send_batch_max_size must be set too --
  # send_batch_size alone is only the flush trigger, not a cap, so a burst
  # that crosses it before a flush would otherwise go out as one oversized
  # request instead of being split.
  batch/metrics:
    send_batch_size: 200
    send_batch_max_size: 200
    timeout: 10s
  # The logs endpoint's hard caps are 10,000 log events and 1 MB uncompressed
  # per request (https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-OTLPEndpoint.html#CloudWatch-LimitsandRestrictions).
  # Unlike the metrics/traces receivers, the batch processor has no
  # byte-size dimension to enforce that 1 MB cap directly -- send_batch_size
  # and send_batch_max_size only count log records. 500 is chosen well under
  # the 10,000-event cap to leave headroom for that untracked byte dimension:
  # it stays under 1 MB even at ~2 KB/record, comfortably above what this
  # demo's structured logs run (debug-level collector self-telemetry
  # included). timeout caps the other side: never hold a log more than 10s
  # waiting for a batch to fill.
  batch/logs:
    send_batch_size: 500
    send_batch_max_size: 500
    timeout: 10s
  # The traces endpoint's hard caps are 10,000 spans and 5 MB uncompressed
  # per request (https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-OTLPEndpoint.html#CloudWatch-LimitsandRestrictions;
  # there's also a 200 KB single-span cap and a 16 KB single-resource+scope
  # cap, neither of which batch size controls). Same reasoning as
  # batch/logs above: the batch processor only counts spans, it has no
  # byte-size dimension to enforce the 5 MB cap directly, so 500 is chosen
  # well under the 10,000-span cap to leave headroom for that untracked
  # byte dimension -- it stays under 5 MB even at ~10 KB/span, well above
  # what this demo's spans run. timeout caps the other side: never hold a
  # span more than 15s waiting for a batch to fill.
  batch/traces:
    send_batch_size: 500
    send_batch_max_size: 500
    timeout: 15s
  # Compaction only (no `keys`): merges ResourceSpans/ResourceLogs/
  # ResourceMetrics entries that already share an identical Resource+Scope
  # instead of extracting new ones. Placed before batch/traces, batch/metrics,
  # and batch/logs below so the batch processors -- which concatenate many
  # incoming export requests into fewer, larger ones -- aren't carrying one
  # duplicate Resource+Scope per original request for the same service. Keeps
  # requests further under the 16 KB per-unique-resource+scope cap that the
  # traces, metrics, and logs endpoints all enforce, and makes send_batch_size
  # closer to actual record count instead of inflated by repeated resource
  # headers.
  groupbyattrs:

exporters:
  # CloudWatch's OpenTelemetry traces endpoint, replacing the awsxray exporter
  # for the same reason metrics/logs moved off their AWS-specific exporters:
  # plain OTLP/HTTP with SigV4 signing. Requires Transaction Search to be
  # enabled on the account first -- without it, requests fail with "The OTLP
  # API is supported with CloudWatch Logs as a Trace Segment Destination".
  # That's an account-wide, one-time setting (not per-deployment IAM), not
  # currently managed by this Terraform -- see the deployment README.
  # https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/CloudWatch-Transaction-Search.html
  otlphttp/traces:
    traces_endpoint: https://xray.{{ aws_region }}.amazonaws.com/v1/traces
    compression: gzip
    auth:
      authenticator: sigv4auth/traces
  # CloudWatch's OpenTelemetry metrics endpoint. This is plain OTLP/HTTP with
  # SigV4 signing rather than an AWS-specific exporter, so metrics land in
  # CloudWatch's OTel metric store -- queried with PromQL in Query Studio,
  # not as a classic namespace in the Metrics console.
  otlphttp/metrics:
    metrics_endpoint: https://monitoring.{{ aws_region }}.amazonaws.com/v1/metrics
    compression: gzip
    auth:
      authenticator: sigv4auth/metrics
  # CloudWatch's OpenTelemetry logs endpoint, replacing the awscloudwatchlogs
  # exporter for the same reason metrics moved off awsemf: it's plain
  # OTLP/HTTP with SigV4 signing rather than an AWS-specific exporter. Unlike
  # the metrics endpoint, the log group/stream aren't part of the URL -- they
  # go in the x-aws-log-group/x-aws-log-stream headers instead (query params
  # aren't supported on this endpoint), and those headers are static per
  # exporter instance -- there's no per-record templating the way the old
  # awscloudwatchlogs exporter's {ServiceName} placeholder did. Hence one
  # exporter instance per service below, fed by the routing connector, so
  # each still gets its own stream. logs_endpoint, not endpoint, for the same
  # reason as metrics_endpoint: the otlphttp exporter appends /v1/logs to
  # `endpoint`, which would double the path.
  # https://docs.aws.amazon.com/AmazonCloudWatch/latest/logs/CWL_HTTP_Endpoints_OTLP.html
{% for svc in log_stream_services %}
  otlphttp/logs/{{ svc }}:
    logs_endpoint: https://logs.{{ aws_region }}.amazonaws.com/v1/logs
    compression: gzip
    headers:
      x-aws-log-group: '{{ app_log_group }}'
      x-aws-log-stream: '{{ svc }}'
    auth:
      authenticator: sigv4auth/logs
{% endfor %}
  # The collector's own self-telemetry (looped back through its otlp
  # receiver, see service.telemetry below) carries service.name
  # "otelcol-contrib", not one of the app services above. Its own log group
  # (not app_log_group) so it doesn't turn up in searches/correlations scoped
  # to the app services' log group.
  otlphttp/logs/otel-collector:
    logs_endpoint: https://logs.{{ aws_region }}.amazonaws.com/v1/logs
    compression: gzip
    headers:
      x-aws-log-group: '{{ otelcol_log_group }}'
      x-aws-log-stream: 'otel-collector'
    auth:
      authenticator: sigv4auth/logs
  # Catch-all for anything not in log_stream_services -- e.g. the "full"
  # compose profile's accounting/fraud-detection/kafka, or a new service that
  # hasn't been added to the list above yet. Better than silently dropping it.
  otlphttp/logs/other:
    logs_endpoint: https://logs.{{ aws_region }}.amazonaws.com/v1/logs
    compression: gzip
    headers:
      x-aws-log-group: '{{ app_log_group }}'
      x-aws-log-stream: 'other'
    auth:
      authenticator: sigv4auth/logs

connectors:
  # CloudWatch returns HTTP success for a partially accepted OTLP request, so
  # the exporter records the exact rejected point count only in a structured
  # "Partial success response" log. Convert that dropped_data_points value to
  # a delta monotonic OTLP metric instead of counting warning events: one event
  # can represent many dropped points. The connector is an exporter on the
  # logs pipeline and a receiver on the metrics pipeline below, so the metric
  # follows the same processors and otlphttp/metrics exporter as app metrics.
  signal_to_metrics/cloudwatch_partial_success:
    error_mode: ignore
    logs:
      - name: demo.collector.exporter.dropped_metric_data_points
        description: Number of metric data points the OTLP backend reported dropping.
        conditions:
          - 'body == "Partial success response" and attributes["dropped_data_points"] != nil'
        sum:
          value: Int(attributes["dropped_data_points"])
          monotonic: true
  # Splits the logs pipeline by service.name so each service's exporter
  # (above) can point at its own static x-aws-log-stream header -- see the
  # comment on the otlphttp/logs/* exporters for why this indirection exists.
  routing/cloudwatch_logs:
    error_mode: ignore
    default_pipelines: [logs/other]
    table:
{% for svc in log_stream_services %}
      - condition: resource.attributes["service.name"] == "{{ svc }}"
        pipelines: [logs/{{ svc }}]
{% endfor %}
      - condition: resource.attributes["service.name"] == "otelcol-contrib"
        pipelines: [logs/otel-collector]
  # Emits one count metric per signal (spans, metric datapoints, log
  # records), broken down by the dimensions needed to tell deployments and
  # replicas apart: service.name identifies which service; Application and
  # service.namespace both carry project_name (see resource/aws_application
  # above), the same value awsApplication tags AWS resources with, so counts
  # can be grouped/filtered the same way those resources are;
  # deployment.environment.name is the demo's "env" (dev/staging/prod);
  # service.instance.id and host.name disambiguate multiple concurrently
  # running replicas of the same service -- service.instance.id is the OTel
  # SDK's own per-process identity (present on app-emitted spans/logs), and
  # host.name (set by resourcedetection, from the `system` detector) covers
  # everything else, including collector-scraped signals with no SDK
  # identity of their own.
  count:
    spans:
      demo.span.count:
        description: Count of spans received, by service and deployment identity.
        attributes:
          - key: service.name
            default_value: unknown
          - key: Application
            default_value: unknown
          - key: service.namespace
            default_value: unknown
          - key: deployment.environment.name
            default_value: unknown
          - key: service.instance.id
            default_value: unknown
          - key: host.name
            default_value: unknown
    datapoints:
      demo.metric_datapoint.count:
        description: Count of metric data points received, by service and deployment identity.
        attributes:
          - key: service.name
            default_value: unknown
          - key: Application
            default_value: unknown
          - key: service.namespace
            default_value: unknown
          - key: deployment.environment.name
            default_value: unknown
          - key: service.instance.id
            default_value: unknown
          - key: host.name
            default_value: unknown
    logs:
      demo.log_record.count:
        description: Count of log records received, by service and deployment identity.
        attributes:
          - key: service.name
            default_value: unknown
          - key: Application
            default_value: unknown
          - key: service.namespace
            default_value: unknown
          - key: deployment.environment.name
            default_value: unknown
          - key: service.instance.id
            default_value: unknown
          - key: host.name
            default_value: unknown

service:
  # health_check must be repeated here -- the base config's service.extensions
  # (otelcol-config.yml) is an array, and arrays are replaced, not merged,
  # across --config layers. Dropping it silently disables compose.yaml's
  # otel-collector healthcheck (grpc_health_probe against :13134) on AWS.
  extensions: [health_check, sigv4auth/metrics, sigv4auth/logs, sigv4auth/traces]
  # The base config's telemetry.metrics already loops the collector's own
  # self-telemetry back through its otlp receiver (127.0.0.1, via
  # OTEL_COLLECTOR_HOST/PORT_HTTP), so it rides the same metrics pipeline --
  # and thus the same CloudWatch exporter -- as everything else with no
  # further wiring. metrics.level stays raised above the default (Normal) to
  # get the full internal metric set; logs.level is left at the base
  # config's default (Info) rather than Debug, which produced enough
  # self-generated log volume to matter for CloudWatch Logs ingestion cost.
  telemetry:
    metrics:
      level: detailed
  pipelines:
    traces:
      processors: [resourcedetection, memory_limiter, resource/aws_log_correlation, resource/aws_application, resource/aws_deployment, transform/sanitize_spans, gen_ai_normalizer, groupbyattrs, batch/traces]
      # debug dropped from the base list: it prints every span to the
      # collector's own stdout, which is unnecessary volume once spans are
      # actually landing in X-Ray via otlphttp/traces below. count added so
      # every span is tallied into demo.span.count (see the connector above)
      # on its way to X-Ray.
      exporters: [span_metrics, otlphttp/traces, count]
    metrics:
      # receivers isn't overridden here (inherits the base config's full
      # list), unlike the sibling deploy/aws-ecs overlay, which drops
      # docker_stats/host_metrics since Fargate can't serve them -- EC2 has
      # both. count added as a receiver (not exporter) here: it's
      # metrics/count_tap below, not this pipeline, that feeds the count
      # connector, so demo.metric_datapoint.count's own data points don't
      # loop back into the connector that produced them.
      receivers: [docker_stats, http_check/frontend-proxy, host_metrics, nginx, otlp, redis, postgresql, prometheus/ad, prometheus/envoy, prometheus/flagd, span_metrics, count/frontend_proxy_http, count, signal_to_metrics/cloudwatch_partial_success]
      processors: [resourcedetection, memory_limiter, resource/aws_log_correlation, resource/aws_application, resource/aws_deployment, resource/sanitize_cloudwatch_metrics, transform/sanitize_cloudwatch_metric_resources, filter/cloudwatch_metrics, metric_start_time, groupbyattrs, batch/metrics]
      # debug dropped, same reasoning as the traces pipeline above.
      exporters: [otlphttp/metrics]
    # Exists only to feed demo.metric_datapoint.count without the metrics
    # pipeline above exporting to and receiving from count at the same time,
    # which would have count re-counting its own previously emitted data
    # points every interval. Same receivers as metrics (fanned out
    # independently, not shared state), a minimal processor chain since
    # nothing here is exported over the network, and no CloudWatch-specific
    # processors -- those exist to make otlphttp/metrics requests valid,
    # irrelevant to a pipeline whose only exporter is an in-process connector.
    metrics/count_tap:
      receivers: [docker_stats, http_check/frontend-proxy, host_metrics, nginx, otlp, redis, postgresql, prometheus/ad, prometheus/envoy, prometheus/flagd, span_metrics, count/frontend_proxy_http]
      processors: [resourcedetection, memory_limiter, resource/aws_application, resource/aws_deployment]
      exporters: [count]
    logs:
      # processors repeats the base list (resourcedetection, memory_limiter,
      # transform/sanitize_logs) since this key wasn't previously overridden
      # here -- adding resource/aws_application/groupbyattrs/batch/logs means
      # the array as a whole must be replaced, per the deep-merge note at the
      # top of this file.
      processors: [resourcedetection, memory_limiter, transform/sanitize_logs, resource/aws_application, resource/aws_deployment, groupbyattrs, batch/logs]
      # debug dropped, same reasoning as the traces pipeline above. count
      # added so every log record is tallied into demo.log_record.count.
      exporters: [routing/cloudwatch_logs, count/frontend_proxy_http, count, signal_to_metrics/cloudwatch_partial_success]
    # Docker's Fluent Forward driver supplies stdout records and container
    # metadata, but no OTel Resource. Add flagd's identity here, then reuse the
    # same sanitization, batching, routing, and OTLP exporter path as SDK logs.
    logs/flagd-stdout:
      receivers: [fluent_forward/flagd]
      processors: [memory_limiter, transform/sanitize_logs, resource/flagd_logs, resource/aws_application, resource/aws_deployment, groupbyattrs, batch/logs]
      exporters: [routing/cloudwatch_logs, count]
{% for svc in log_stream_services %}
    logs/{{ svc }}:
      receivers: [routing/cloudwatch_logs]
      exporters: [otlphttp/logs/{{ svc }}]
{% endfor %}
    logs/otel-collector:
      receivers: [routing/cloudwatch_logs]
      exporters: [otlphttp/logs/otel-collector]
    logs/other:
      receivers: [routing/cloudwatch_logs]
      exporters: [otlphttp/logs/other]
