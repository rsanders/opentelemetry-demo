# Rendered by Ansible (roles/otel_demo) from otelcol-config-extras-aws.yml.j2.
# Overwrites the upstream stub at src/otel-collector/otelcol-config-extras.yml,
# which is the repo's documented seam for adding exporters without touching
# upstream files. This file is always loaded last on top of otelcol-config.yml,
# so it only needs to repeat the *exporters* arrays it wants to keep (map keys
# merge; only conflicting array keys are replaced) -- see the comment in the
# original stub for details.

extensions:
  # Signs requests to the CloudWatch metrics OTLP endpoint. Credentials come
  # from the EC2 instance role through the default AWS SDK chain.
  sigv4auth/metrics:
    service: 'monitoring'
    region: {{ aws_region }}

processors:
  # CloudWatch's OTLP metrics endpoint only supports Counter, Gauge, and
  # Histogram (https://docs.aws.amazon.com/AmazonCloudWatch/latest/monitoring/metrics-otel-send.html#metrics-otel-send-types).
  # Anything else -- Summary, ExponentialHistogram, or a typeless metric shell
  # with no data points -- gets rejected per-metric with "Invalid OTel metric
  # type" on an otherwise-successful request. Drop those before they're sent
  # rather than pay for a rejected request every export interval.
  filter/cloudwatch_metrics:
    error_mode: ignore
    metric_conditions:
      - 'metric.type == METRIC_DATA_TYPE_SUMMARY'
      - 'metric.type == METRIC_DATA_TYPE_EXPONENTIAL_HISTOGRAM'
      - 'metric.type == METRIC_DATA_TYPE_NONE'
  # CloudWatch rejects cumulative points with no StartTimeUnixNano, and the
  # prometheus/ad receiver (like prometheus receivers generally) doesn't set
  # one. subtract_initial_point over the true_reset_point default: it never
  # emits a start==end point (some backends reject those), and it's
  # stateless, which matters since the collector is force-recreated on every
  # deploy. Trade-off: each series' first point after a restart is dropped.
  metric_start_time:
    strategy: subtract_initial_point
  # Sized to stay inside the metrics endpoint's per-request limits of 1000
  # data points and 1 MB uncompressed. send_batch_max_size must be set too --
  # send_batch_size alone is only the flush trigger, not a cap, so a burst
  # that crosses it before a flush would otherwise go out as one oversized
  # request instead of being split.
  batch/metrics:
    send_batch_size: 200
    send_batch_max_size: 200
    timeout: 10s

exporters:
  awsxray:
    region: {{ aws_region }}
  awscloudwatchlogs:
    region: {{ aws_region }}
    log_group_name: '{{ app_log_group }}'
    log_stream_name: 'otel-collector'
  # CloudWatch's OpenTelemetry metrics endpoint. This is plain OTLP/HTTP with
  # SigV4 signing rather than an AWS-specific exporter, so metrics land in
  # CloudWatch's OTel metric store -- queried with PromQL in Query Studio,
  # not as a classic namespace in the Metrics console.
  otlphttp/metrics:
    metrics_endpoint: https://monitoring.{{ aws_region }}.amazonaws.com/v1/metrics
    compression: gzip
    auth:
      authenticator: sigv4auth/metrics

service:
  extensions: [sigv4auth/metrics]
  pipelines:
    traces:
      exporters: [debug, span_metrics, awsxray]
    metrics:
      processors: [resourcedetection, memory_limiter, filter/cloudwatch_metrics, metric_start_time, batch/metrics]
      exporters: [debug, otlphttp/metrics]
    logs:
      exporters: [debug, awscloudwatchlogs]
