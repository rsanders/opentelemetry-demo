# Deployed by Ansible (roles/otel_demo) alongside the upstream compose files.
# `ports` entries merge (concatenate) across -f files per the Compose spec,
# so this adds a :80 publish for frontend-proxy without touching compose.yaml.
services:
  ad:
    # Extend the already-pulled public image with the probe used by
    # compose.yaml's gRPC health check. This avoids rebuilding the Java
    # application and all of its Gradle dependencies on every deployment.
    build:
      context: .
      dockerfile: deploy/aws/Dockerfile.ad
      args:
        AD_BASE_IMAGE: ${IMAGE_NAME}:${DEMO_VERSION}-ad
    deploy:
      resources:
        limits:
          memory: 450M
  load-generator:
    environment:
      - K6_OTEL_TRACES_ENABLED=false
      - K6_LOG_LEVEL=warn
    deploy:
      resources:
        limits:
          memory: 768M
  payment:
    deploy:
      resources:
        limits:
          # Sized from a local load test at ~3.7k req/s: RSS ramped from a
          # ~190M idle baseline to a 330-444M plateau with no further growth.
          memory: 512M
  product-catalog:
    deploy:
      resources:
        limits:
          memory: 30M
  otel-collector:
    # Docker's logging driver runs in the host daemon, outside the Compose
    # network, so it cannot reach the collector by service name. Publish the
    # Fluent Forward receiver(s) on loopback only; flagd's (and, when enabled,
    # agent/chatbot/mcp's) stdout enters here and leaves the collector through
    # the existing OTLP/HTTP logs exporter.
    ports:
      - "127.0.0.1:8006:8006"
{% if enable_agent_layer | default(false) | bool %}
      - "127.0.0.1:8007:8007"
      - "127.0.0.1:8008:8008"
      - "127.0.0.1:8009:8009"
{% endif %}
  frontend-proxy:
    ports:
      - "80:8080"
  # flagd v0.16 can export metrics and traces over OTLP but not its operational
  # logs. Send stdout to the collector's Fluent Forward receiver instead; the
  # dedicated logs/flagd-stdout pipeline converts it to OTel logs and uses the
  # normal OTLP CloudWatch path. Async mode prevents a collector restart from
  # blocking flagd startup, buffering records until the receiver reconnects.
  flagd:
    # Layers compose.flagd-overrides-aws.json (rendered from
    # flagd-overrides-aws.json.j2) on top of the upstream src/flagd/demo.flagd.json
    # as a second flagd sync source -- flagd merges sources by flag key, with
    # later --uri args winning on conflict, so this overrides individual flags
    # (e.g. loadGeneratorVUs' default) without touching the upstream file.
    volumes:
      - ./compose.flagd-overrides-aws.json:/etc/flagd-aws-overrides.json:ro
    command: [
      "start",
      "--uri",
      "file:./etc/flagd/demo.flagd.json",
      "--uri",
      "file:/etc/flagd-aws-overrides.json",
      "--management-port",
      "${FLAGD_MANAGEMENT_PORT}"
    ]
    logging:
      driver: fluentd
      options:
        fluentd-address: "tcp://127.0.0.1:8006"
        fluentd-async: "true"
        fluentd-sub-second-precision: "true"
        tag: "flagd"
{% if enable_agent_layer | default(false) | bool %}
  # None of these three images are published anywhere this deploy can reach
  # (see ecr.tf); `make push-agentic-images` pushes them to these ECR repos
  # instead. This whole block is only rendered when enable_agent_layer is
  # true -- compose.agent.yaml (which defines these services in the first
  # place) is only layered in on that same condition, and an override-only
  # service block would otherwise start an orphaned, config-less container.
  agent:
    image: "{{ agent_image }}"
    # None of the three emit OTel logs via SDK (unlike every other service
    # here) -- route stdout through the collector's Fluent Forward receivers
    # instead, same fix as flagd above, on their own ports/tags so each keeps
    # its own service.name (see otelcol-config-extras-aws.yml.j2).
    logging:
      driver: fluentd
      options:
        fluentd-address: "tcp://127.0.0.1:8007"
        fluentd-async: "true"
        fluentd-sub-second-precision: "true"
        tag: "agent"
  chatbot:
    image: "{{ chatbot_image }}"
    logging:
      driver: fluentd
      options:
        fluentd-address: "tcp://127.0.0.1:8008"
        fluentd-async: "true"
        fluentd-sub-second-precision: "true"
        tag: "chatbot"
  mcp:
    image: "{{ mcp_image }}"
    logging:
      driver: fluentd
      options:
        fluentd-address: "tcp://127.0.0.1:8009"
        fluentd-async: "true"
        fluentd-sub-second-precision: "true"
        tag: "mcp"
{% endif %}
