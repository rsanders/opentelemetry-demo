            "type": "Extension/HubsExtension/PartType/MarkdownPart",
            "settings": {
              "content": {
                "settings": {
                  "title": "OpenTelemetry Demo: product-catalog",
                  "subtitle": "Application Insights / Log Analytics",
                  "content": "Request golden signals and service telemetry for `product-catalog` over the last 6 hours. [Open Application Insights](https://portal.azure.com/#@/resource/subscriptions/0194be82-31af-4b66-88d1-3f3455eb859a/resourceGroups/azure-otel-demo-rg/providers/Microsoft.Insights/components/azure-otel-demo-insights/overview)."
                }
              }
            }
          }
        },
        {
          "position": {
            "x": 0,
            "y": 2,
            "colSpan": 8,
            "rowSpan": 5
          },
          "metadata": {
            "inputs": [
              {
                "name": "resourceTypeMode",
                "isOptional": true
              },
              {
                "name": "ComponentId",
                "value": "/subscriptions/0194be82-31af-4b66-88d1-3f3455eb859a/resourceGroups/azure-otel-demo-rg/providers/Microsoft.OperationalInsights/workspaces/azure-otel-demo-logs",
                "isOptional": true
              },
              {
                "name": "Scope",
                "value": {
                  "resourceIds": [
                    "/subscriptions/0194be82-31af-4b66-88d1-3f3455eb859a/resourceGroups/azure-otel-demo-rg/providers/Microsoft.OperationalInsights/workspaces/azure-otel-demo-logs"
                  ]
                },
                "isOptional": true
              },
              {
                "name": "PartId",
                "value": "otel-demo-0-2",
                "isOptional": true
              },
              {
                "name": "Version",
                "value": "2.0",
                "isOptional": true
              },
              {
                "name": "TimeRange",
                "isOptional": true
              },
              {
                "name": "DashboardId",
                "isOptional": true
              },
              {
                "name": "Query",
                "value": "AppRequests\n| where TimeGenerated > ago(6h) and (AppRoleName == \"product-catalog\" or AppRoleName endswith \".product-catalog\")\n| summarize RequestsPerSecond=sum(ItemCount)/60.0 by bin(TimeGenerated, 1m)\n| order by TimeGenerated asc",
                "isOptional": true
              },
              {
                "name": "ControlType",
                "value": "FrameControlChart",
                "isOptional": true
              },
              {
                "name": "PartTitle",
                "value": "Request rate",
                "isOptional": true
              },
              {
                "name": "PartSubTitle",
                "value": "Requests per second",
                "isOptional": true
              },
              {
                "name": "IsQueryContainTimeRange",
                "value": true,
                "isOptional": true
              },
              {
                "name": "SpecificChart",
                "value": "Line",
                "isOptional": true
              },
              {
                "name": "Dimensions",
                "value": {
                  "xAxis": {
                    "name": "TimeGenerated",
                    "type": "datetime"
                  },
                  "yAxis": [
                    {
                      "name": "RequestsPerSecond",
                      "type": "real"
                    }
                  ],
                  "aggregation": "Average"
                },
                "isOptional": true
              },
              {
                "name": "LegendOptions",
                "value": {
                  "isEnabled": true,
                  "position": "Bottom"
                },
                "isOptional": true
              }
            ],
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart"
          }
        },
        {
          "position": {
            "x": 8,
