          },
          "metadata": {
            "inputs": [
              {
                "name": "resourceTypeMode",
                "isOptional": true
              },
              {
                "name": "ComponentId",
                "value": "/subscriptions/0194be82-31af-4b66-88d1-3f3455eb859a/resourceGroups/azure-otel-demo-rg/providers/Microsoft.OperationalInsights/workspaces/azure-otel-demo-logs",
                "isOptional": true
              },
              {
                "name": "Scope",
                "value": {
                  "resourceIds": [
                    "/subscriptions/0194be82-31af-4b66-88d1-3f3455eb859a/resourceGroups/azure-otel-demo-rg/providers/Microsoft.OperationalInsights/workspaces/azure-otel-demo-logs"
                  ]
                },
                "isOptional": true
              },
              {
                "name": "PartId",
                "value": "otel-demo-8-2",
                "isOptional": true
              },
              {
                "name": "Version",
                "value": "2.0",
                "isOptional": true
              },
              {
                "name": "TimeRange",
                "isOptional": true
              },
              {
                "name": "DashboardId",
                "isOptional": true
              },
              {
                "name": "Query",
                "value": "AppRequests\n| where TimeGenerated > ago(6h) and (AppRoleName == \"product-catalog\" or AppRoleName endswith \".product-catalog\")\n| summarize Requests=sum(ItemCount), Failures=sumif(ItemCount, Success == false) by bin(TimeGenerated, 1m)\n| extend ErrorPercent=iff(Requests == 0, 0.0, 100.0 * todouble(Failures) / Requests)\n| project TimeGenerated, ErrorPercent\n| order by TimeGenerated asc",
                "isOptional": true
              },
              {
                "name": "ControlType",
                "value": "FrameControlChart",
                "isOptional": true
              },
              {
                "name": "PartTitle",
                "value": "Error rate",
                "isOptional": true
              },
              {
                "name": "PartSubTitle",
                "value": "Failed requests as a percentage",
                "isOptional": true
              },
              {
                "name": "IsQueryContainTimeRange",
                "value": true,
                "isOptional": true
              },
              {
                "name": "SpecificChart",
                "value": "Line",
                "isOptional": true
              },
              {
                "name": "Dimensions",
                "value": {
                  "xAxis": {
                    "name": "TimeGenerated",
                    "type": "datetime"
                  },
                  "yAxis": [
                    {
                      "name": "ErrorPercent",
                      "type": "real"
                    }
                  ],
                  "aggregation": "Average"
                },
                "isOptional": true
              },
              {
                "name": "LegendOptions",
                "value": {
                  "isEnabled": true,
                  "position": "Bottom"
                },
                "isOptional": true
              }
            ],
            "type": "Extension/Microsoft_OperationsManagementSuite_Workspace/PartType/LogsDashboardPart"
          }
        },
